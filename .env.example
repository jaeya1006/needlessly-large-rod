# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다.

# 로컬 MariaDB 계정 (needlessly_large_rod DB)
DB_USERNAME=nlr
DB_PASSWORD=

# 정부 혜택 추천 (#23)
# 공공데이터포털(data.go.kr) 「행정안전부_대한민국 공공서비스(혜택) 정보」 일반 인증키(Decoding)
DATA_GO_KR_API_KEY=
# Anthropic Console(console.anthropic.com)에서 만든 API 키
ANTHROPIC_API_KEY=

# 로그인 토큰 서명 키 (#27). 아무 긴 무작위 문자열, 예: openssl rand -hex 32
JWT_SECRET=
